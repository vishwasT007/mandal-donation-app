rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ✅ Gallery images - Public read, authenticated upload
    match /gallery/{allPaths=**} {
      allow read: if true; // Public read for gallery display
      allow write: if request.auth != null; // Only authenticated users can upload
    }
    
    // ✅ Receipts - Secure access
    match /receipts/{allPaths=**} {
      allow read: if true; // Public read for receipt access
      allow write: if request.auth != null; // Only authenticated users can create
    }
    
    // ❌ Deny access to all other files by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
} 